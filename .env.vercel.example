# Vercel → Project Settings → Environment Variables → Production
# Copy only the values you need into Vercel. Keep real secrets out of Git.
APP_ORIGIN=https://mun-smoky.vercel.app
GOOGLE_CALLBACK_URL=https://mun-smoky.vercel.app/api/auth/google/callback
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MUN Assistant (Groq free tier) with Wikipedia sources.
AI_ENABLED=true
AI_ORGANIZATION_ELIGIBILITY_CONFIRMED=true
AI_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# OneSignal web push (REST key from API keys; private key from Identity Verification, base64).
PUSH_ENABLED=true
PUSH_MODE=members
PUSH_AUDIENCE_APPROVED=true
ONESIGNAL_APP_ID=
ONESIGNAL_SAFARI_WEB_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_IDENTITY_VERIFIED=true
ONESIGNAL_IDENTITY_PRIVATE_KEY_BASE64=
CRON_SECRET=

# Cloudinary (profile photos) - from cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
