{
  "name": "miu-mun-portal",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "npm start",
    "build": "node --check server.mjs && node --check database.mjs && node --check dist/app.js && node --check dist/sw.js",
    "typecheck": "tsc -p tsconfig.base.json",
    "test": "node --test test/portal.test.mjs",
    "db:migrate:deploy": "node --env-file-if-exists=.env migrate.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2"
  }
}
